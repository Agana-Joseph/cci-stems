# Public Backend API Base URL (no trailing slash)
# Example: http://localhost:8000 or https://cci-stem-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: Estimated assessment completion time displayed on Welcome screen (minutes)
NEXT_PUBLIC_ESTIMATED_ASSESSMENT_MINUTES=8

# ==============================================================================
# SERVER-SIDE ONLY VARIABLES (NEVER prefix with NEXT_PUBLIC_)
# ==============================================================================

# Optional server-side override for backend URL (defaults to NEXT_PUBLIC_API_BASE_URL)
API_BASE_URL=http://localhost:8000

# Administrative API key passed via X-API-Key by the server-side proxy (/api/admin/*)
# Must match ADMIN_API_KEY configured on the FastAPI backend.
ADMIN_API_KEY=

# Optional actor identifier forwarded in X-Actor-Id for backend audit logs
ADMIN_ACTOR_ID=admin-dashboard

# Deployment-level admin gate:
# Set to "true" ONLY when /admin and /api/admin/* are protected by a deployment-level
# access control (e.g. reverse proxy auth, VPN, Cloudflare Access, or Basic Auth).
# In development (NODE_ENV !== "production"), the admin proxy works when ADMIN_API_KEY is set.
ADMIN_DASHBOARD_ENABLED=true
